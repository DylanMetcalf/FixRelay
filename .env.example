# ---- Required ----
DATABASE_URL="postgresql://fixrelay:fixrelay@localhost:5432/fixrelay_dev"
APP_URL="http://localhost:3000"            # public URL, used in emailed links

# ---- Files: db (default, multi-instance) | s3 | local ----
STORAGE_DRIVER="db"
# STORAGE_DIR="./.storage"                 # local driver only
# S3_BUCKET="fixrelay-files"  S3_REGION="auto"  S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""  S3_SECRET_ACCESS_KEY=""  S3_FORCE_PATH_STYLE="false"  S3_SSE="AES256"

# ---- Email: console (default, logs only) | smtp | resend ----
EMAIL_TRANSPORT="console"
EMAIL_FROM="FixRelay <no-reply@example.com>"
# SMTP_HOST=""  SMTP_PORT="587"  SMTP_USER=""  SMTP_PASS=""  SMTP_SECURE="false"
# RESEND_API_KEY=""

# ---- Antivirus (recommended in production; uploads are refused if configured but unreachable) ----
# CLAMAV_HOST="127.0.0.1"  CLAMAV_PORT="3310"   # or CLAMAV_SOCKET="/run/clamav/clamd.ctl"

# ---- Background work ----
# WORKER_IN_PROCESS="true"    # run the worker inside the web process (single-instance hosting)
# WORKER_INTERVAL_MS="15000"

# ---- Tests ----
TEST_DATABASE_URL="postgresql://fixrelay:fixrelay@localhost:5432/fixrelay_test"
# RATE_LIMIT_STORE="memory"   # only for single-process development
