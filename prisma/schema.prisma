// ManOp schema (formerly FixRelay). Every tenant-owned table carries orgId. See DATABASE.md.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  APPROVER
  TECHNICIAN
  STORES // stores / procurement: issues and buys spares for jobs
  REQUESTER
}

enum JobRoute {
  UNDECIDED
  IN_HOUSE
  CONTRACTOR
}

enum JobSource {
  APP
  PUBLIC_LINK
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum JobStatus {
  NEW
  ASSESSING
  ASSESSED
  QUOTING
  AWAITING_APPROVAL
  APPROVED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  AWAITING_VERIFICATION
  VERIFIED
  CLOSED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
  WITHDRAWN
}

enum QuoteKind {
  ORIGINAL
  VARIATION
}

enum LineKind {
  LABOUR
  MATERIAL
  OTHER
}

enum LinkPurpose {
  QUOTE
  COMPLETION
}

enum DecisionOutcome {
  APPROVED
  REJECTED
}

enum DecisionVia {
  LINK
  PORTAL
  IN_PERSON
  INTERNAL
}

enum AttachmentKind {
  REQUEST
  ASSESSMENT
  QUOTE
  PROGRESS
  BEFORE
  AFTER
  TEST_DOCUMENT
  SIGNATURE
  LOGO
}

enum UpdateKind {
  PROGRESS
  NOTE
  CLARIFICATION
  ADDITIONAL_WORK
}

enum CompletionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String
  isPlatformAdmin Boolean   @default(false)
  emailVerifiedAt DateTime?
  phone           String    @default("")
  jobTitle        String    @default("")
  photoKey        String? // profile photo in file storage (optional)
  demoPersona     Boolean   @default(false) // a sample person inside a demo company; cannot sign in, can be "viewed as"
  createdAt       DateTime  @default(now())

  sessions    Session[]
  authTokens  AuthToken[]
  memberships Membership[]
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique
  userId      String   @db.Uuid
  activeOrgId String?  @db.Uuid
  actAsUserId String?  @db.Uuid // demo companies only: the demonstrator is viewing as this sample person
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organisation {
  id                         String    @id @default(uuid()) @db.Uuid
  name                       String
  slug                       String    @unique
  isDemo                     Boolean   @default(false)
  brandColour                String    @default("#1e5aa8")
  logoAttachmentId           String?   @db.Uuid
  address                    String    @default("")
  phone                      String    @default("")
  contactEmail               String    @default("")
  currency                   String    @default("ZAR")
  // Approvals (amounts in cents, incl. VAT). See WORKFLOWS.md "Approvals".
  managerApprovalLimitCents  Int       @default(500000) // maintenance managers approve up to R5 000
  approverApprovalLimitCents Int?      @default(5000000) // approvers up to R50 000; null = no limit; above → owner
  poRequired                 Boolean   @default(false)
  multiQuoteThresholdCents   Int       @default(1000000) // above R10 000 …
  minQuotes                  Int       @default(3) // … this many quotes are needed (or a recorded reason)
  reporterConfirmation       Boolean   @default(true) // the person who reported a fault confirms it is fixed
  publicReportingEnabled     Boolean   @default(false) // anyone with a site link / QR code can report without an account
  jobSeq                     Int       @default(0)
  referencePrefix            String    @default("REQ-") // requisition number prefix ("" = plain numbers like 12600)
  requireSignatures          Boolean   @default(false) // drawn signatures required on the requisition (reported, received, completed, originator, manager, approval)
  quoteSeq                   Int       @default(0)
  archivedAt                 DateTime? // demo companies replaced by "reset demo" (audit rows are append-only, so nothing is deleted)
  createdAt                  DateTime  @default(now())

  memberships  Membership[]
  subscription Subscription?
  priorities   PriorityRule[]
}

model Membership {
  id                    String           @id @default(uuid()) @db.Uuid
  orgId                 String           @db.Uuid
  userId                String           @db.Uuid
  roles                 Role[]
  siteIds               String[]         @default([]) // empty = all sites; otherwise the member only sees/approves these sites
  active                Boolean          @default(true)
  status                MembershipStatus @default(ACTIVE) // PENDING: registered with a site code, waiting for an administrator
  joinCodeId            String?          @db.Uuid
  requestedDepartmentId String?          @db.Uuid
  createdAt             DateTime         @default(now())

  org  Organisation @relation(fields: [orgId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @db.Uuid
  email      String
  name       String    @default("")
  roles      Role[]
  siteIds    String[]  @default([])
  tokenHash  String    @unique
  invitedBy  String    @db.Uuid
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId])
}

model PriorityRule {
  orgId           String   @db.Uuid
  priority        Priority
  responseHours   Int
  completionHours Int

  org Organisation @relation(fields: [orgId], references: [id])

  @@id([orgId, priority])
}

model Site {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  address     String   @default("")
  publicToken String   @unique // identifies the site in its public report link and QR codes (not a secret)
  publicCode  String?  @unique // short, random code for /r/{code} links (no database IDs in public URLs)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  locations Location[]
  assets    Asset[]
  jobs      Job[]

  @@unique([orgId, id])
  @@index([orgId, name])
}

model Location {
  id         String  @id @default(uuid()) @db.Uuid
  orgId      String  @db.Uuid
  siteId     String  @db.Uuid
  name       String
  /// Food-handling area: completion asks "tools out = tools in, area clean and tidy".
  foodArea   Boolean @default(false)
  publicCode String? @unique // short code for this area's QR sign

  site   Site    @relation(fields: [orgId, siteId], references: [orgId, id])
  assets Asset[]
  jobs   Job[]

  @@unique([orgId, id])
  @@index([orgId, siteId])
}

model Asset {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  siteId       String   @db.Uuid
  locationId   String?  @db.Uuid
  reference    String
  name         String
  type         String   @default("")
  manufacturer String   @default("")
  model        String   @default("")
  serialNumber String   @default("")
  notes        String   @default("")
  publicCode   String?  @unique // short code for this machine's QR label
  createdAt    DateTime @default(now())

  site     Site      @relation(fields: [orgId, siteId], references: [orgId, id])
  location Location? @relation(fields: [orgId, locationId], references: [orgId, id])
  jobs     Job[]

  @@unique([orgId, id])
  @@unique([orgId, reference])
}

// A maintenance request and the job it becomes are ONE record moving through JobStatus.
model Job {
  id                   String          @id @default(uuid()) @db.Uuid
  orgId                String          @db.Uuid
  reference            String
  title                String
  description          String
  category             String          @default("General")
  priority             Priority        @default(NORMAL)
  emergency            Boolean         @default(false)
  isProject            Boolean         @default(false) // planned project work rather than a breakdown ("Projects" box on the requisition)
  sparesStatus         SparesStatus    @default(NOT_NEEDED) // set at assessment, moved on by stores
  sparesList           String          @default("") // which spares or parts are needed
  sparesNote           String          @default("") // stores' latest note (supplier, where to collect)
  sparesEta            DateTime? // expected arrival when ordered
  status               JobStatus       @default(NEW)
  heldFromStatus       JobStatus?
  holdReason           String?
  cancelReason         String?
  directAuthReason     String?
  siteId               String          @db.Uuid
  locationId           String?         @db.Uuid
  assetId              String?         @db.Uuid
  requesterId          String?         @db.Uuid // null when reported through a public link
  source               JobSource       @default(APP)
  reporterName         String? // public-link reports
  reporterPhone        String?
  reporterEmail        String?
  route                JobRoute        @default(UNDECIDED)
  contractorId         String?         @db.Uuid // appointed contractor (route CONTRACTOR)
  recommendedQuoteId   String?         @db.Uuid // quote put forward for approval above the manager's limit
  quoteDeadline        DateTime?
  quoteExceptionReason String? // why fewer quotes than required were accepted
  poNumber             String?
  approvedCostCents    Int?
  ownerId              String?         @db.Uuid // responsible manager / dispatcher
  leadTechnicianId     String?         @db.Uuid
  instructions         String?
  plannedStart         DateTime?
  plannedEnd           DateTime?
  dueAt                DateTime?
  reporterConfirmation Boolean         @default(true)
  reportedAt           DateTime        @default(now())
  respondedAt          DateTime? // first time the job left NEW (used for response-time reporting)
  assignedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  closedAt             DateTime?
  reopenCount          Int             @default(0)
  overdueNotifiedAt    DateTime?
  departmentId         String?         @db.Uuid // department currently responsible (see JobHandover)
  duplicateStatus      DuplicateStatus @default(NONE)
  possibleDuplicateIds String[]        @default([]) // open/recent jobs this report looks like (for manager review)
  duplicateOfId        String?         @db.Uuid // linked by a manager as a duplicate of this job
  repeatOfId           String?         @db.Uuid // the fault came back after this (closed) job
  submissionKey        String? // one per form; stops double submissions creating two jobs
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  contractor      Contractor?      @relation(fields: [orgId, contractorId], references: [orgId, id])
  site            Site             @relation(fields: [orgId, siteId], references: [orgId, id])
  location        Location?        @relation(fields: [orgId, locationId], references: [orgId, id])
  asset           Asset?           @relation(fields: [orgId, assetId], references: [orgId, id])
  technicians     JobTechnician[]
  assessments     Assessment[]
  quotes          Quote[]
  updates         WorkUpdate[]
  completions     Completion[]
  attachments     Attachment[]
  contractorLinks ContractorLink[]
  signatures      JobSignature[]
  events          ActivityEvent[]
  department      Department?      @relation(fields: [orgId, departmentId], references: [orgId, id])
  handovers       JobHandover[]

  @@unique([orgId, id])
  @@unique([orgId, reference])
  @@unique([orgId, submissionKey])
  @@index([orgId, departmentId])
  @@index([orgId, duplicateStatus])
  @@index([orgId, status])
  @@index([orgId, siteId])
  @@index([orgId, leadTechnicianId])
  @@index([orgId, sparesStatus])
}

model JobTechnician {
  orgId  String @db.Uuid
  jobId  String @db.Uuid
  userId String @db.Uuid

  job Job @relation(fields: [orgId, jobId], references: [orgId, id], onDelete: Cascade)

  @@id([jobId, userId])
  @@index([orgId, userId])
}

model Assessment {
  id                   String       @id @default(uuid()) @db.Uuid
  orgId                String       @db.Uuid
  jobId                String       @db.Uuid
  authorId             String       @db.Uuid
  findings             String
  suspectedCause       String       @default("")
  recommendedWork      String       @default("")
  materials            String       @default("")
  labourHoursEstimate  Decimal?     @db.Decimal(8, 2)
  quoteRequired        Boolean
  externalHelpRequired Boolean      @default(false)
  sparesNeeded         SparesStatus @default(NOT_NEEDED)
  sparesList           String       @default("")
  createdAt            DateTime     @default(now())

  job Job @relation(fields: [orgId, jobId], references: [orgId, id])

  @@index([orgId, jobId])
}

// Each revision is a NEW row sharing `number` with version+1. Non-draft rows are immutable (DB trigger).
model Quote {
  id            String      @id @default(uuid()) @db.Uuid
  orgId         String      @db.Uuid
  jobId         String      @db.Uuid
  number        String
  version       Int         @default(1)
  kind          QuoteKind   @default(ORIGINAL)
  contractorId  String?     @db.Uuid
  leadTimeDays  Int?
  viaLink       Boolean     @default(false) // submitted by the contractor through their link (vs captured by staff)
  status        QuoteStatus @default(DRAFT)
  scope         String      @default("")
  terms         String      @default("")
  validUntil    DateTime?
  vatRateBps    Int         @default(0) // snapshot of org VAT at creation; 0 = not VAT registered
  subtotalCents Int         @default(0)
  vatCents      Int         @default(0)
  totalCents    Int         @default(0)
  createdById   String      @db.Uuid
  submittedAt   DateTime?
  decidedAt     DateTime?
  createdAt     DateTime    @default(now())

  job        Job         @relation(fields: [orgId, jobId], references: [orgId, id])
  lines      QuoteLine[]
  decision   Decision?
  contractor Contractor? @relation(fields: [orgId, contractorId], references: [orgId, id])

  @@unique([orgId, id])
  @@unique([orgId, number, version])
  @@index([orgId, jobId])
  @@index([orgId, status])
}

model QuoteLine {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  quoteId        String   @db.Uuid
  position       Int
  kind           LineKind
  description    String
  quantity       Decimal  @db.Decimal(12, 3)
  unitPriceCents Int
  taxable        Boolean  @default(true)
  lineTotalCents Int

  quote Quote @relation(fields: [orgId, quoteId], references: [orgId, id], onDelete: Cascade)

  @@index([quoteId])
}

model Completion {
  id             String           @id @default(uuid()) @db.Uuid
  orgId          String           @db.Uuid
  jobId          String           @db.Uuid
  version        Int
  status         CompletionStatus @default(SUBMITTED)
  workPerformed  String
  observations   String           @default("")
  completedAt    DateTime
  submittedById  String?          @db.Uuid // null when the contractor submitted through their link
  contractorId   String?          @db.Uuid
  rootCauses     RootCause[]
  rootCauseNotes String           @default("")
  toolsAndAreaOk Boolean? // food areas only: tools out = tools in, area clean and tidy
  createdAt      DateTime         @default(now())

  job      Job       @relation(fields: [orgId, jobId], references: [orgId, id])
  decision Decision?

  @@unique([orgId, id])
  @@unique([jobId, version])
}

// Secure customer review link. Only the SHA-256 of the token is stored.
// Secure link for an external contractor: submit a quote (QUOTE) or completion evidence (COMPLETION) for one job.
// Only the SHA-256 of the token is stored.
model ContractorLink {
  id           String      @id @default(uuid()) @db.Uuid
  orgId        String      @db.Uuid
  jobId        String      @db.Uuid
  contractorId String      @db.Uuid
  purpose      LinkPurpose
  /// What the contractor is asked to quote for (QUOTE links), shown on their page.
  scope        String?
  tokenHash    String      @unique
  createdById  String      @db.Uuid
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())

  job        Job        @relation(fields: [orgId, jobId], references: [orgId, id])
  contractor Contractor @relation(fields: [orgId, contractorId], references: [orgId, id])

  @@index([orgId, jobId])
}

// External contractors the site uses. Not users: they work through ContractorLinks.
model Contractor {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  name          String
  trade         String   @default("")
  contactName   String   @default("")
  email         String   @default("")
  phone         String   @default("")
  vatRegistered Boolean  @default(false)
  vatNumber     String   @default("")
  notes         String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  jobs   Job[]
  quotes Quote[]
  links  ContractorLink[]

  @@unique([orgId, id])
  @@index([orgId, name])
}

// One decision per quote version / completion version (unique constraints stop duplicates under concurrency).
model Decision {
  id                    String          @id @default(uuid()) @db.Uuid
  orgId                 String          @db.Uuid
  jobId                 String          @db.Uuid
  quoteId               String?         @unique @db.Uuid
  completionId          String?         @unique @db.Uuid
  outcome               DecisionOutcome
  via                   DecisionVia
  deciderUserId         String?         @db.Uuid
  deciderName           String
  deciderEmail          String          @default("")
  recordedById          String?         @db.Uuid // staff member who captured an IN_PERSON / INTERNAL decision
  linkId                String?         @db.Uuid
  comment               String          @default("")
  signatureAttachmentId String?         @db.Uuid
  ipAddress             String          @default("")
  createdAt             DateTime        @default(now())

  quote      Quote?      @relation(fields: [quoteId], references: [id])
  completion Completion? @relation(fields: [completionId], references: [id])

  @@index([orgId, jobId])
}

model WorkUpdate {
  id                  String     @id @default(uuid()) @db.Uuid
  orgId               String     @db.Uuid
  jobId               String     @db.Uuid
  authorId            String     @db.Uuid
  kind                UpdateKind @default(PROGRESS)
  note                String
  labourMinutes       Int        @default(0)
  materialDescription String     @default("")
  materialCostCents   Int        @default(0)
  createdAt           DateTime   @default(now())

  job Job @relation(fields: [orgId, jobId], references: [orgId, id])

  @@index([orgId, jobId])
}

model Attachment {
  id           String         @id @default(uuid()) @db.Uuid
  orgId        String         @db.Uuid
  jobId        String?        @db.Uuid
  quoteId      String?        @db.Uuid
  completionId String?        @db.Uuid
  kind         AttachmentKind
  storageKey   String         @unique
  filename     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?        @db.Uuid
  createdAt    DateTime       @default(now())

  job Job? @relation(fields: [orgId, jobId], references: [orgId, id])

  @@index([orgId, jobId])
}

// Append-only audit trail (DB trigger rejects UPDATE/DELETE).
model ActivityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  jobId       String?  @db.Uuid
  type        String
  summary     String
  actorUserId String?  @db.Uuid
  actorLabel  String
  data        Json     @default("{}")
  createdAt   DateTime @default(now())

  job Job? @relation(fields: [orgId, jobId], references: [orgId, id])

  @@index([orgId, jobId, createdAt])
  @@index([orgId, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  orgId     String    @db.Uuid
  userId    String    @db.Uuid
  jobId     String?   @db.Uuid
  type      String
  title     String
  body      String    @default("")
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, orgId, readAt])
}

model OutboxEmail {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String?      @db.Uuid
  toEmail       String
  subject       String
  body          String
  dedupeKey     String       @unique
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, nextAttemptAt])
}

model Plan {
  id            String  @id @default(uuid()) @db.Uuid
  code          String  @unique
  name          String
  maxUsers      Int? // null = unlimited
  maxActiveJobs Int?
  maxSites      Int?
  active        Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  orgId              String             @unique @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceEndsAt        DateTime?
  providerRef        String?
  updatedAt          DateTime           @updatedAt

  org  Organisation @relation(fields: [orgId], references: [id])
  plan Plan         @relation(fields: [planId], references: [id])
}

// Explicit, time-bound, audited permission for the platform operator to view a tenant.
model SupportAccessGrant {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid
  grantedById String    @db.Uuid
  reason      String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId])
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// Single-use, expiring tokens sent by email. Only the SHA-256 of the token is stored.
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Shared fixed-window rate limiter (works across any number of app instances).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// File bytes for STORAGE_DRIVER=db (default). Keeps files inside the database backup.
model StoredFile {
  key       String   @id
  bytes     Bytes
  createdAt DateTime @default(now())
}

enum RootCause {
  MAINTENANCE
  AGE_OF_MACHINE
  OPERATOR
  HUMAN_ERROR
  WEAR_AND_TEAR
  BREAKDOWN
  CHANGE_OVER
  OTHER
}

/// The signature lines of the maintenance work requisition.
enum SignatureStep {
  REPORTED // Submitted by
  RECEIVED // Submitted to (maintenance)
  APPROVAL // Quote / spend signed off
  COMPLETED // Work completed by
  ORIGINATOR // Confirmed by originator
  MANAGER // Confirmed by manager
}

/// A drawn signature on one line of the requisition. Date and time are recorded automatically. Append-only.
model JobSignature {
  id           String        @id @default(uuid()) @db.Uuid
  orgId        String        @db.Uuid
  jobId        String        @db.Uuid
  step         SignatureStep
  name         String
  userId       String?       @db.Uuid // null for public reporters and contractors
  attachmentId String        @db.Uuid // the PNG (Attachment kind SIGNATURE)
  quoteId      String?       @db.Uuid
  completionId String?       @db.Uuid
  ip           String?
  signedAt     DateTime      @default(now())

  job Job @relation(fields: [orgId, jobId], references: [orgId, id])

  @@index([orgId, jobId])
}

/// Spares or parts for a job: none, in stock (stores to issue), to buy (stores to order), ordered, ready (issued or received).
enum SparesStatus {
  NOT_NEEDED
  ON_HAND
  TO_BUY
  ORDERED
  READY
}

enum MembershipStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum DuplicateStatus {
  NONE
  FLAGGED // looks like another job – a manager should review
  LINKED // a manager linked it to the original
  DISMISSED // a manager said it is not a duplicate
}

/// Organisational grouping (Maintenance, Operations, Finance …). Separate from roles (authority) and job status.
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  members DepartmentMember[]
  jobs    Job[]

  @@unique([orgId, id])
  @@unique([orgId, name])
}

model DepartmentMember {
  orgId        String   @db.Uuid
  departmentId String   @db.Uuid
  userId       String   @db.Uuid
  isManager    Boolean  @default(false) // department manager: sees and hands over the department's jobs
  createdAt    DateTime @default(now())

  department Department @relation(fields: [orgId, departmentId], references: [orgId, id])

  @@id([departmentId, userId])
  @@index([orgId, userId])
}

/// A job passed from one department or person to another, with the reason / next action. Append-only (trigger).
model JobHandover {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @db.Uuid
  jobId            String   @db.Uuid
  fromDepartmentId String?  @db.Uuid
  toDepartmentId   String?  @db.Uuid
  fromUserId       String?  @db.Uuid
  toUserId         String?  @db.Uuid
  byUserId         String   @db.Uuid
  reason           String
  createdAt        DateTime @default(now())

  job Job @relation(fields: [orgId, jobId], references: [orgId, id])

  @@index([orgId, jobId])
}

/// Site registration code employees use to ask for access. Never grants access by itself: an administrator approves.
model JoinCode {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid
  siteId      String?   @db.Uuid
  code        String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime?
  revokedAt   DateTime?
  uses        Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([orgId])
}

/// Unexpected server errors, for the platform console. No request bodies or personal data beyond IDs.
model ErrorLog {
  id        String   @id @default(uuid()) @db.Uuid
  source    String
  message   String
  path      String   @default("")
  orgId     String?  @db.Uuid
  userId    String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([createdAt])
}
